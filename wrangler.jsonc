{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sideline",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // The phone app lives in /public and is served by the same Worker
  // (static asset requests are free and don't count toward the daily limit).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/about"]
  },

  // Errors and slow requests show up under Workers & Pages > sideline > Logs.
  // Free plan: 200,000 log events a day, kept for 3 days.
  "observability": { "enabled": true },

  // Per-device and per-network request limits (see overLimit in src/worker.js).
  // Set far above normal use; they only stop runaway devices and bots.
  "ratelimits": [
    { "name": "DEVICE_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 1200, "period": 60 } }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "AFL", "class_name": "AflStream" },
      { "name": "QUOTA", "class_name": "DailyQuota" }
    ]
  },
  // The free plan only supports SQLite-backed Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AflStream", "DailyQuota"] }
  ],

  "vars": {
    // Only needed if you host the app somewhere other than this Worker.
    "ALLOWED_ORIGINS": ""
  }
  // Secrets (kept out of the repo), set once with:
  //   npx wrangler secret put CONTACT_EMAIL     (Squiggle requires it in the User-Agent)
  //   npx wrangler secret put API_FOOTBALL_KEY  (optional Premier League backup)
  // For local `npm run dev`, put the same values in a .dev.vars file.
}
